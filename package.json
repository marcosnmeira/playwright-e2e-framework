{
  "name": "playwright-e2e-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Framework E2E com Playwright + TypeScript para portfólio de QA Automation.",
  "scripts": {
    "app:start": "node ./utils/demo-server.cjs",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "validate": "npm run lint && npm run typecheck && npm run test"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa",
    "e2e",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "dotenv": "18.0.4",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
